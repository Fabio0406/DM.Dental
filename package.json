{
  "name": "proyecto-dm5",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "docker exec -i dm5-postgres psql -U postgres -d sistema_dm5 -v ON_ERROR_STOP=1 < database/migrations/001_importacion_salmi.sql",
    "db:psql": "docker exec -it dm5-postgres psql -U postgres -d sistema_dm5",
    "seed": "node seeds/createUsers.js",
    "seed:insumos": "node seeds/createInsumos.js",
    "seed:stock": "node seeds/updateStock.js",
    "seed:protocolos": "node seeds/createProtocolos.js",
    "seed:lotes": "node seeds/createLotes.js",
    "seed:all": "npm run seed && npm run seed:insumos && npm run seed:protocolos && npm run seed:lotes"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.1.3",
    "chart.js": "^4.4.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "lucide": "^0.553.0",
    "multer": "^2.0.2",
    "onnxruntime-node": "^1.23.2",
    "pg": "^8.16.3",
    "ppu-paddle-ocr": "^6.0.0",
    "puppeteer": "^24.31.0",
    "sharp": "^0.34.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
