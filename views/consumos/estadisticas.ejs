<%
const s = stats || {};
const totalApl = parseInt(s.total_aplicaciones_consumidas) || 0;
const valorTotal = parseFloat(s.valor_total_consumido) || 0;
const recibos = parseInt(s.total_servicios) || 0;
const insumosDistintos = parseInt(s.insumos_diferentes_usados) || 0;
const maxApl = porInsumo.length ? Math.max(...porInsumo.map(r => parseInt(r.aplicaciones) || 0)) : 0;
const etiquetaPeriodo = { 7: '7 días', 30: '30 días', 90: '90 días', 365: '1 año' };

const body = `
<div class="page-header">
    <div>
        <div class="page-eyebrow"><i data-lucide="chart-column" class="icon-sm"></i> <a href="/consumos/historial">Historial de consumos</a></div>
        <h1 class="page-title">Estadísticas de consumo</h1>
        <p class="page-subtitle">${periodo ? 'Período analizado: ' + periodo : 'Resumen de tus consumos registrados.'}</p>
    </div>
    <div class="page-actions">
        <div class="btn-group" role="group" aria-label="Período">
            ${periodos.map(p => `<a href="/consumos/estadisticas?dias=${p}" class="btn ${p === dias ? 'btn-primary' : 'btn-light'}" ${p === dias ? 'aria-current="true"' : ''}>${etiquetaPeriodo[p]}</a>`).join('')}
        </div>
    </div>
</div>

${locals.error ? `<div class="alert alert-danger mb-3" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div></div>` : ''}

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card tone-info">
            <span class="stat-icon"><i data-lucide="receipt"></i></span>
            <div><p class="stat-label">Recibos atendidos</p><p class="stat-value">${recibos}</p></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card tone-success">
            <span class="stat-icon"><i data-lucide="activity"></i></span>
            <div><p class="stat-label">Aplicaciones consumidas</p><p class="stat-value">${totalApl}</p></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card tone-neutral">
            <span class="stat-icon"><i data-lucide="boxes"></i></span>
            <div><p class="stat-label">Insumos distintos</p><p class="stat-value">${insumosDistintos}</p></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card tone-warning">
            <span class="stat-icon"><i data-lucide="wallet"></i></span>
            <div><p class="stat-label">Valor consumido</p><p class="stat-value">Bs ${valorTotal.toFixed(2)}</p></div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header">
        <div>
            <h2 class="card-title"><i data-lucide="list-ordered"></i> Consumo por insumo</h2>
            <p class="card-subtitle">Ordenado de mayor a menor número de aplicaciones</p>
        </div>
    </div>
    ${porInsumo.length === 0 ? `
        <div class="empty-state">
            <div class="empty-icon"><i data-lucide="chart-no-axes-column"></i></div>
            <h3>Sin consumos en este período</h3>
            <p>Prueba con un período más amplio o registra un consumo.</p>
            <a href="/consumos/registro" class="btn btn-primary"><i data-lucide="plus"></i> Registrar consumo</a>
        </div>
    ` : `
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th style="width: 34%">Participación</th>
                        <th class="text-end">Aplicaciones</th>
                        <th class="text-end">Recibos</th>
                        <th class="text-end">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    ${porInsumo.map(r => {
                        const apl = parseInt(r.aplicaciones) || 0;
                        const pct = totalApl ? Math.round(apl / totalApl * 100) : 0;
                        const ancho = maxApl ? Math.round(apl / maxApl * 100) : 0;
                        return `
                        <tr>
                            <td>
                                <span class="cell-main">${esc(r.nombre_generico)}</span>
                                <span class="cell-sub"><code>${esc(r.codigo)}</code></span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="meter flex-grow-1"><span style="width: ${ancho}%"></span></div>
                                    <span class="small text-muted num" style="min-width: 36px">${pct}%</span>
                                </div>
                            </td>
                            <td class="text-end num fw-semibold">${apl}</td>
                            <td class="text-end num">${r.recibos}</td>
                            <td class="text-end num">Bs ${parseFloat(r.valor || 0).toFixed(2)}</td>
                        </tr>`;
                    }).join('')}
                </tbody>
            </table>
        </div>
    `}
</div>
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
