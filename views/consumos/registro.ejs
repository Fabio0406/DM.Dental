<%
const lotesAgotadosJson = JSON.stringify(locals.lotes_agotados || []).replace(/</g, '\\u003c');

const body = `
<div class="page-header">
    <div>
        <div class="page-eyebrow"><i data-lucide="package-minus" class="icon-sm"></i> Inventario</div>
        <h1 class="page-title">Registrar consumo</h1>
        <p class="page-subtitle">Elige el servicio realizado y ajusta las aplicaciones de cada insumo según el protocolo.</p>
    </div>
    <div class="page-actions">
        <a href="/consumos/historial" class="btn btn-light"><i data-lucide="history"></i> Ver historial</a>
    </div>
</div>

${success || error ? `
<div class="flash-stack">
    ${success ? `<div class="alert alert-success alert-dismissible fade show" role="status"><i data-lucide="circle-check"></i><div>${success}</div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>` : ''}
    ${error ? `<div class="alert alert-danger alert-dismissible fade show" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>` : ''}
</div>` : ''}

<form method="POST" action="/consumos/registro" id="consumoForm">
    <input type="hidden" name="insumos" id="hidden_insumos">
    <input type="hidden" name="numero_recibo" id="hidden_numero_recibo">

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label for="id_tipo_servicio" class="form-label">1. Servicio realizado<span class="req">*</span></label>
                    <select class="form-select form-select-lg" id="id_tipo_servicio" name="id_tipo_servicio" required aria-describedby="servicioHelp">
                        <option value="">Selecciona un servicio…</option>
                        ${tiposServicio.map(ts => `<option value="${ts.id_servicio}">${esc(ts.nombre)}</option>`).join('')}
                    </select>
                    <div id="servicioHelp" class="form-text">Se cargarán los insumos y cantidades estándar del protocolo.</div>
                </div>
                <div class="col-lg-7">
                    <div id="disponibilidad_alert"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div>
                <h2 class="card-title"><i data-lucide="list-checks"></i> 2. Insumos del protocolo</h2>
                <p class="card-subtitle">Las cantidades están en aplicaciones. Se descuentan del lote que vence primero (FIFO).</p>
            </div>
        </div>
        <div class="card-body">
            <div id="protocolo_mensaje">
                <div class="empty-state">
                    <div class="empty-icon"><i data-lucide="mouse-pointer-click"></i></div>
                    <h3>Selecciona un servicio</h3>
                    <p>Los insumos del protocolo aparecerán aquí para que ajustes las cantidades.</p>
                </div>
            </div>
            <div id="protocolo_container" style="display: none;">
                <div class="row g-3" id="protocolo_grid"></div>
            </div>
        </div>
    </div>

    <div class="action-bar">
        <div class="action-summary">
            <strong id="total_aplicaciones">0 insumos</strong> seleccionados para descontar
        </div>
        <div class="d-flex gap-2">
            <a href="/dashboard" class="btn btn-light">Cancelar</a>
            <button type="button" class="btn btn-primary" id="btn_guardar" onclick="mostrarModalRecibo()" disabled>
                <i data-lucide="check"></i> Registrar consumo
            </button>
        </div>
    </div>
</form>

<!-- Modal: Número de recibo -->
<div class="modal fade" id="reciboModal" tabindex="-1" aria-labelledby="reciboTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="reciboTitulo"><span class="modal-icon"><i data-lucide="receipt"></i></span> Confirmar consumo</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="resumen_consumo" class="mb-3"></div>
                <label for="numero_recibo_input" class="form-label">N° de recibo recetario<span class="req">*</span></label>
                <input type="text" class="form-control" id="numero_recibo_input" placeholder="Ej: REC-001-2025" required aria-describedby="reciboHelp">
                <div id="reciboHelp" class="form-text">Se registrará como documento de respaldo en el kardex.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Volver</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarConsumo" onclick="confirmarConsumo()"><i data-lucide="check"></i> Confirmar y registrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Lote agotado -->
<div class="modal fade" id="agotadoModal" tabindex="-1" aria-labelledby="agotadoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="agotadoTitulo"><span class="modal-icon danger"><i data-lucide="package-x"></i></span> Marcar lote como agotado</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1 fw-semibold" id="agotado_insumo_nombre"></p>
                <p class="text-muted small">Lote <code id="agotado_lote_numero"></code> · El saldo restante del lote se ajustará a cero en el kardex.</p>
                <input type="hidden" id="agotado_lote_id">
                <label for="motivo_agotado" class="form-label">Motivo</label>
                <textarea class="form-control" id="motivo_agotado" rows="2" placeholder="Ej: derramado, contaminado, vencido…"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" onclick="confirmarAgotado()"><i data-lucide="package-x"></i> Marcar agotado</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Verificación de sobrantes -->
<div class="modal fade" id="verificarSobrantesModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="sobrantesTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="sobrantesTitulo"><span class="modal-icon warning"><i data-lucide="triangle-alert"></i></span> Verificación de sobrantes</h2>
            </div>
            <div class="modal-body">
                <p class="text-muted">Estos lotes llegaron a cero con este consumo. Indica si físicamente quedó producto para ajustar el kardex.</p>
                <div id="sobrantes_list_dinamico"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="guardarAjustesSobrantes()"><i data-lucide="save"></i> Guardar y continuar</button>
            </div>
        </div>
    </div>
</div>

<script>window.LOTES_AGOTADOS = ${lotesAgotadosJson};</script>
<script src="/js/consumo-registro.js"></script>
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
