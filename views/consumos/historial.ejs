<%
const totalAplicaciones = consumos.reduce((s, c) => s + (parseInt(c.cantidad) || 0), 0);
const recibos = new Set(consumos.map(c => c.numero_recibo)).size;

const body = `
<div class="page-header">
    <div>
        <div class="page-eyebrow"><i data-lucide="history" class="icon-sm"></i> Inventario</div>
        <h1 class="page-title">Historial de consumos</h1>
        <p class="page-subtitle">Salidas registradas en el kardex a tu nombre (últimos 100 movimientos).</p>
    </div>
    <div class="page-actions">
        <a href="/consumos/estadisticas" class="btn btn-light"><i data-lucide="chart-column"></i> Estadísticas</a>
        <a href="/consumos/registro" class="btn btn-primary"><i data-lucide="plus"></i> Registrar consumo</a>
    </div>
</div>

${locals.error ? `<div class="alert alert-danger mb-3" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div></div>` : ''}

<div class="card mb-3">
    <div class="card-body">
        <form method="GET" action="/consumos/historial" class="filter-bar">
            <div class="filter-field">
                <label for="fecha" class="form-label">Mostrar desde</label>
                <input type="date" class="form-control" id="fecha" name="fecha" value="${locals.fechaFiltro || ''}">
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i data-lucide="funnel"></i> Filtrar</button>
                ${locals.fechaFiltro ? `<a href="/consumos/historial" class="btn btn-light"><i data-lucide="x"></i> Limpiar</a>` : ''}
            </div>
            ${consumos.length > 0 ? `
            <div class="ms-auto d-flex gap-4 text-end">
                <div><div class="stat-label">Movimientos</div><div class="fw-bold fs-5 num">${consumos.length}</div></div>
                <div><div class="stat-label">Recibos</div><div class="fw-bold fs-5 num">${recibos}</div></div>
                <div><div class="stat-label">Aplicaciones</div><div class="fw-bold fs-5 num">${totalAplicaciones}</div></div>
            </div>` : ''}
        </form>
    </div>
</div>

<div class="card table-card">
    ${consumos.length === 0 ? `
        <div class="empty-state">
            <div class="empty-icon"><i data-lucide="inbox"></i></div>
            <h3>${locals.fechaFiltro ? 'Sin consumos desde esa fecha' : 'Aún no registraste consumos'}</h3>
            <p>${locals.fechaFiltro ? 'Prueba con una fecha anterior o limpia el filtro.' : 'Cuando registres el consumo de un servicio, sus salidas aparecerán aquí.'}</p>
            <a href="/consumos/registro" class="btn btn-primary"><i data-lucide="plus"></i> Registrar consumo</a>
        </div>
    ` : `
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Recibo</th>
                        <th>Insumo</th>
                        <th>Lote</th>
                        <th class="text-end">Aplicaciones</th>
                        <th class="text-end">Saldo valorado</th>
                        <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    ${consumos.map(c => `
                        <tr>
                            <td class="num">
                                <span class="cell-main">${new Date(c.fecha).toLocaleDateString('es-BO')}</span>
                                <span class="cell-sub">${new Date(c.fecha).toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit' })}</span>
                            </td>
                            <td><span class="badge badge-soft-brand">${esc(c.numero_recibo || '—')}</span></td>
                            <td>
                                <span class="cell-main">${esc(c.nombre_generico)}</span>
                                <span class="cell-sub"><code>${esc(c.codigo)}</code></span>
                            </td>
                            <td>${c.numero_lote ? `<code>${esc(c.numero_lote)}</code>` : '—'}</td>
                            <td class="text-end num fw-semibold text-danger-emphasis">−${c.cantidad}</td>
                            <td class="text-end num">Bs ${parseFloat(c.saldo_valorado || 0).toFixed(2)}</td>
                            <td class="text-end">
                                <button type="button" class="btn-icon" onclick="verDetalles(${c.id_detalle})" title="Ver detalle" aria-label="Ver detalle del movimiento">
                                    <i data-lucide="eye" class="icon-sm"></i>
                                </button>
                            </td>
                        </tr>
                    `).join('')}
                </tbody>
            </table>
        </div>
    `}
</div>

<!-- Modal: detalle del movimiento -->
<div class="modal fade" id="detallesModal" tabindex="-1" aria-labelledby="detallesTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="detallesTitulo"><span class="modal-icon"><i data-lucide="receipt"></i></span> Detalle del consumo</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="detalles_content"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
const detallesModal = new bootstrap.Modal(document.getElementById('detallesModal'));

async function verDetalles(idDetalle) {
    const content = document.getElementById('detalles_content');
    content.innerHTML = '<div class="text-center py-4"><div class="spinner-border" role="status"></div></div>';
    detallesModal.show();
    try {
        const response = await fetch('/consumos/api/detalles/' + idDetalle);
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.error || 'Sin datos');
        const d = data.detalles;
        const e = DM5.escape;
        content.innerHTML =
            '<p class="fw-semibold mb-0">' + e(d.nombre_generico) + '</p>' +
            '<p class="text-muted small mb-3"><code>' + e(d.codigo) + '</code> · ' + e(d.presentacion || '') + '</p>' +
            '<dl class="meta-grid">' +
                '<div><dt>Fecha</dt><dd>' + DM5.fecha(d.fecha, true) + '</dd></div>' +
                '<div><dt>Recibo</dt><dd>' + e(d.numero_recibo || '—') + '</dd></div>' +
                '<div><dt>Aplicaciones</dt><dd>' + e(d.cantidad) + '</dd></div>' +
                '<div><dt>Costo unitario</dt><dd>' + DM5.moneda(d.costo_unitario) + '</dd></div>' +
                '<div><dt>Lote</dt><dd>' + e(d.numero_lote || '—') + '</dd></div>' +
                '<div><dt>Vencimiento</dt><dd>' + DM5.fecha(d.fecha_vencimiento) + '</dd></div>' +
                '<div><dt>Saldo tras salida</dt><dd>' + e(d.saldo) + ' apl.</dd></div>' +
                '<div><dt>Saldo valorado</dt><dd>' + DM5.moneda(d.saldo_valorado) + '</dd></div>' +
                '<div><dt>Kardex</dt><dd>N° ' + e(d.numero_kardex) + ' · ' + e(d.gestion) + '</dd></div>' +
                '<div><dt>Registrado por</dt><dd>' + e(d.usuario || '—') + '</dd></div>' +
            '</dl>';
    } catch (error) {
        content.innerHTML = '<div class="alert alert-danger mb-0"><i data-lucide="circle-alert"></i><div>No se pudo cargar el detalle del consumo.</div></div>';
    }
    DM5.icons();
}
</script>
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
