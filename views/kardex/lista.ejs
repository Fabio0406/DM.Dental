<%
// Estado coherente con las alertas: desabastecimiento = stock <= mínimo
const estadoDe = (ins) => {
    const stock = parseInt(ins.aplicaciones_disponibles) || 0;
    if (ins.aplicaciones_minimas === undefined) return null;
    const min = parseInt(ins.aplicaciones_minimas) || 0;
    if (stock === 0) return { tono: 'danger', texto: 'Agotado' };
    if (stock <= min) return { tono: 'warning', texto: 'Bajo mínimo' };
    return { tono: 'success', texto: 'Normal' };
};

const conteo = { danger: 0, warning: 0, success: 0 };
insumos.forEach(i => { const e = estadoDe(i); if (e) conteo[e.tono]++; });

const body = `
<div class="page-header">
    <div>
        <div class="page-eyebrow"><i data-lucide="book-open" class="icon-sm"></i> Inventario</div>
        <h1 class="page-title">Kardex de insumos</h1>
        <p class="page-subtitle">Stock disponible y kardex valorado de cada insumo de la gestión.</p>
    </div>
    <div class="page-actions">
        <a href="/ocr/upload" class="btn btn-primary"><i data-lucide="scan-line"></i> Ingresar insumos</a>
    </div>
</div>

${locals.error ? `<div class="alert alert-danger alert-dismissible fade show mb-3" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>` : ''}

<div class="card mb-3">
    <div class="card-body">
        <form method="GET" action="/kardex" class="filter-bar" role="search">
            <div class="filter-grow">
                <label for="buscar" class="form-label">Buscar insumo</label>
                <div class="input-icon">
                    <i data-lucide="search"></i>
                    <input type="search" class="form-control" id="buscar" name="buscar" placeholder="Código o nombre del insumo…" value="${esc(termino || '')}">
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Buscar</button>
                ${termino ? `<a href="/kardex" class="btn btn-light"><i data-lucide="x"></i> Limpiar</a>` : ''}
            </div>
            ${!termino && insumos.length > 0 ? `
            <div class="ms-auto chip-legend">
                <span class="badge badge-soft-danger"><span class="status-dot"></span> ${conteo.danger} agotados</span>
                <span class="badge badge-soft-warning"><span class="status-dot"></span> ${conteo.warning} bajo mínimo</span>
                <span class="badge badge-soft-success"><span class="status-dot"></span> ${conteo.success} normales</span>
            </div>` : ''}
        </form>
    </div>
</div>

<div class="card table-card">
    <div class="card-header">
        <h2 class="card-title"><i data-lucide="boxes"></i> ${termino ? 'Resultados para “' + esc(termino) + '”' : 'Insumos'}</h2>
        <span class="badge badge-soft-neutral">${insumos.length} ${insumos.length === 1 ? 'insumo' : 'insumos'}</span>
    </div>
    ${insumos.length === 0 ? `
        <div class="empty-state">
            <div class="empty-icon"><i data-lucide="search-x"></i></div>
            <h3>No se encontraron insumos</h3>
            <p>${termino ? 'Intenta con otro código o nombre.' : 'Ingresa insumos escaneando un formulario SALMI.'}</p>
        </div>
    ` : `
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Insumo</th>
                        <th>Estado</th>
                        <th style="min-width: 190px">Stock (aplicaciones)</th>
                        <th>Kardex</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    ${insumos.map(ins => {
                        const e = estadoDe(ins);
                        const stock = parseInt(ins.aplicaciones_disponibles) || 0;
                        const min = parseInt(ins.aplicaciones_minimas) || 0;
                        // La barra se llena al doble del mínimo
                        const ancho = min ? Math.min(100, Math.round(stock / (min * 2) * 100)) : 100;
                        return `
                        <tr>
                            <td>
                                <span class="cell-main">${esc(ins.nombre_generico)}</span>
                                <span class="cell-sub"><code>${esc(ins.codigo)}</code>${ins.presentacion ? ' · ' + esc(ins.presentacion) : ''}</span>
                            </td>
                            <td>${e ? `<span class="badge badge-soft-${e.tono}"><span class="status-dot"></span> ${e.texto}</span>` : '<span class="text-muted">—</span>'}</td>
                            <td>
                                <div class="d-flex justify-content-between small mb-1">
                                    <strong class="num">${stock}</strong>
                                    ${e ? `<span class="text-muted num">mín. ${min}</span>` : ''}
                                </div>
                                ${e ? `<div class="meter ${e.tono}"><span style="width: ${ancho}%"></span></div>` : ''}
                            </td>
                            <td>
                                ${ins.numero_kardex
                                    ? `<span class="cell-main">N° ${esc(ins.numero_kardex)}</span><span class="cell-sub">Gestión ${ins.gestion}</span>`
                                    : '<span class="badge badge-soft-neutral">Sin kardex</span>'}
                            </td>
                            <td class="text-end">
                                <div class="action-group">
                                    ${ins.abierto
                                        ? `<a href="/kardex/ver/${ins.id_insumo}" class="btn btn-sm btn-outline-primary"><i data-lucide="file-text" class="icon-sm"></i> Ver kardex</a>`
                                        : `<button class="btn btn-sm btn-light" disabled title="Este insumo no tiene un kardex abierto">Sin kardex</button>`}
                                    <a href="/kardex/historial/${ins.id_insumo}" class="btn-icon" title="Kardex de gestiones anteriores" aria-label="Historial de kardex de ${esc(ins.nombre_generico)}">
                                        <i data-lucide="history" class="icon-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>`;
                    }).join('')}
                </tbody>
            </table>
        </div>
    `}
</div>
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
