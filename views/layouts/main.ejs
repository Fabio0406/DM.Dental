<%
const pageTitle = (title || 'Sistema DM-5').split(' - ')[0];
const path = locals.currentPath || '';

// Un enlace queda activo si la ruta coincide con alguno de sus prefijos
const isActive = (...prefixes) => prefixes.some(p => path === p || path.startsWith(p + '/'));

const navSections = [
    { items: [
        { href: '/dashboard', icon: 'layout-dashboard', label: 'Dashboard', active: isActive('/dashboard') }
    ]},
    { title: 'Inventario', items: [
        { href: '/consumos/registro', icon: 'package-minus', label: 'Registrar consumo', active: isActive('/consumos/registro') },
        { href: '/consumos/historial', icon: 'history', label: 'Historial de consumos', active: isActive('/consumos/historial', '/consumos/estadisticas') },
        { href: '/kardex', icon: 'book-open', label: 'Kardex', active: isActive('/kardex') },
        { href: '/solicitudes', icon: 'clipboard-list', label: 'Solicitudes de pedido', active: isActive('/solicitudes') }
    ]},
    { title: 'Ingreso de insumos', items: [
        { href: '/ocr/upload', icon: 'scan-line', label: 'Escanear formulario', active: isActive('/ocr/upload') },
        { href: '/ocr', icon: 'files', label: 'Formularios SALMI', active: path === '/ocr' || isActive('/ocr/review') }
    ]}
];

const iniciales = user ? ((user.nombres || ' ')[0] + (user.apellidos || ' ')[0]).toUpperCase() : '';
%>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" href="/images/escudo.png">
    <script>
        // Aplicar tema antes del primer pintado para evitar parpadeo
        try {
            const t = localStorage.getItem('dm5-theme');
            if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/node_modules/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="/node_modules/lucide/dist/umd/lucide.min.js"></script>
    <script src="/node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</head>

<% if (locals.isAuthenticated) { %>
<body>
    <script>
        try { if (localStorage.getItem('dm5-sidebar') === 'collapsed') document.body.classList.add('sidebar-collapsed'); } catch (e) {}
    </script>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <!-- Sidebar -->
    <aside class="app-sidebar" id="sidebar" aria-label="Navegación principal">
        <a class="sidebar-brand" href="/dashboard">
            <img src="/images/escudo.png" alt="">
            <span>
                <span class="brand-name d-block">Sistema DM-5</span>
                <span class="brand-sub">Inventario odontológico</span>
            </span>
        </a>

        <nav class="sidebar-nav">
            <% navSections.forEach(section => { %>
                <% if (section.title) { %><div class="sidebar-section"><%= section.title %></div><% } %>
                <% section.items.forEach(item => { %>
                    <a class="sidebar-link<%= item.active ? ' active' : '' %>" href="<%= item.href %>" <%- item.active ? 'aria-current="page"' : '' %>>
                        <i data-lucide="<%= item.icon %>"></i>
                        <span><%= item.label %></span>
                    </a>
                <% }) %>
            <% }) %>
        </nav>

        <div class="sidebar-footer">
            <button type="button" class="theme-toggle" id="themeToggle" aria-label="Cambiar tema de color">
                <span class="d-inline-flex align-items-center gap-2">
                    <i data-lucide="moon" class="icon-light"></i>
                    <i data-lucide="sun" class="icon-dark"></i>
                    <span id="themeLabel">Modo oscuro</span>
                </span>
                <i data-lucide="chevron-right" class="icon-sm"></i>
            </button>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="app-main">
        <!-- Topbar -->
        <header class="app-topbar">
            <button type="button" class="icon-btn" id="sidebarToggle" aria-label="Mostrar u ocultar menú" aria-controls="sidebar">
                <i data-lucide="panel-left"></i>
            </button>
            <p class="topbar-title"><%= pageTitle %></p>

            <div class="ms-auto d-flex align-items-center gap-2">
                <!-- Alertas -->
                <div class="dropdown">
                    <button type="button" class="icon-btn" id="alertasNavIcon" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Alertas">
                        <i data-lucide="bell"></i>
                        <span class="notif-dot" id="alertasBadge" style="display: none;">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notif-menu">
                        <div class="notif-head">
                            <strong class="small">Alertas pendientes</strong>
                            <button type="button" class="btn btn-ghost btn-sm" id="marcarTodasLeidas">
                                <i data-lucide="check-check" class="icon-sm"></i> Marcar leídas
                            </button>
                        </div>
                        <div class="notif-list" id="alertasListaDropdown">
                            <div class="text-center text-muted small py-4">Cargando…</div>
                        </div>
                        <div class="notif-foot">
                            <a class="btn btn-ghost btn-sm w-100" href="/dashboard">Ir al dashboard</a>
                        </div>
                    </div>
                </div>

                <!-- Usuario -->
                <div class="dropdown">
                    <a class="user-chip" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar"><%= iniciales %></span>
                        <span class="d-none d-md-inline"><%= user.nombres %> <%= user.apellidos %></span>
                        <i data-lucide="chevron-down" class="icon-sm text-muted"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="px-3 py-2">
                            <div class="fw-semibold small"><%= user.nombres %> <%= user.apellidos %></div>
                            <div class="text-muted small">@<%= user.username %></div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/users/profile"><i data-lucide="user-cog"></i> Mi perfil</a></li>
                        <li>
                            <form method="POST" action="/auth/logout">
                                <button type="submit" class="dropdown-item text-danger"><i data-lucide="log-out"></i> Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="app-content" id="contenido">
            <%- body %>
        </main>
    </div>

    <script>
        // ---- Sidebar ----
        (function () {
            const body = document.body;
            const desktop = () => window.matchMedia('(min-width: 992px)').matches;
            document.getElementById('sidebarToggle').addEventListener('click', function () {
                if (desktop()) {
                    body.classList.toggle('sidebar-collapsed');
                    try { localStorage.setItem('dm5-sidebar', body.classList.contains('sidebar-collapsed') ? 'collapsed' : 'open'); } catch (e) {}
                } else {
                    body.classList.toggle('sidebar-open');
                }
            });
            document.getElementById('sidebarBackdrop').addEventListener('click', () => body.classList.remove('sidebar-open'));
            document.addEventListener('keydown', e => { if (e.key === 'Escape') body.classList.remove('sidebar-open'); });
        })();

        // ---- Tema ----
        (function () {
            const root = document.documentElement;
            const label = document.getElementById('themeLabel');
            const sync = () => { label.textContent = root.getAttribute('data-theme') === 'dark' ? 'Modo claro' : 'Modo oscuro'; };
            sync();
            document.getElementById('themeToggle').addEventListener('click', function () {
                const dark = root.getAttribute('data-theme') !== 'dark';
                if (dark) root.setAttribute('data-theme', 'dark'); else root.removeAttribute('data-theme');
                try { localStorage.setItem('dm5-theme', dark ? 'dark' : 'light'); } catch (e) {}
                sync();
                document.dispatchEvent(new CustomEvent('dm5:themechange'));
            });
        })();

        // ---- Alertas en la barra superior ----
        const alertasBadge = document.getElementById('alertasBadge');
        const alertasLista = document.getElementById('alertasListaDropdown');

        document.getElementById('alertasNavIcon').addEventListener('show.bs.dropdown', cargarAlertasDropdown);

        async function cargarAlertasDropdown() {
            try {
                const response = await fetch('/alertas/no-leidas');
                const data = await response.json();

                if (data.success && data.alertas.length > 0) {
                    alertasLista.innerHTML = data.alertas.slice(0, 6).map(alerta => {
                        const esVencimiento = alerta.titulo.includes('Vencimiento') || alerta.titulo.includes('VENCIDO');
                        const tono = esVencimiento ? 'warning' : 'danger';
                        const icono = esVencimiento ? 'clock' : 'triangle-alert';
                        return '<div class="notif-item" role="button" tabindex="0" onclick="marcarAlertaLeida(' + alerta.id_alerta + ')" title="Marcar como leída">' +
                            '<span class="notif-icon ' + tono + '"><i data-lucide="' + icono + '" class="icon-sm"></i></span>' +
                            '<div class="flex-grow-1 min-w-0">' +
                                '<div class="notif-title">' + DM5.escape(alerta.titulo) + '</div>' +
                                '<div class="notif-meta text-truncate">' + DM5.escape((alerta.codigo || '') + ' ' + (alerta.nombre_generico || '')) + '</div>' +
                                '<div class="notif-meta">' + DM5.fecha(alerta.fecha_creacion) + '</div>' +
                            '</div>' +
                        '</div>';
                    }).join('');

                    if (data.alertas.length > 6) {
                        alertasLista.innerHTML += '<div class="text-center small text-muted py-2">+' + (data.alertas.length - 6) + ' alertas más</div>';
                    }
                } else {
                    alertasLista.innerHTML = '<div class="empty-state py-4"><div class="empty-icon" style="width:48px;height:48px"><i data-lucide="bell-off"></i></div><p class="mb-0 small">No tienes alertas pendientes</p></div>';
                }
                DM5.icons();
            } catch (error) {
                console.error('Error cargando alertas:', error);
                alertasLista.innerHTML = '<div class="text-center text-danger small py-3">No se pudieron cargar las alertas</div>';
            }
        }

        async function actualizarContadorAlertas() {
            try {
                const response = await fetch('/alertas/contar');
                const data = await response.json();
                if (data.success && data.total > 0) {
                    alertasBadge.textContent = data.total > 99 ? '99+' : data.total;
                    alertasBadge.style.display = 'inline-block';
                } else {
                    alertasBadge.style.display = 'none';
                }
            } catch (error) {
                console.error('Error actualizando contador:', error);
            }
        }

        async function marcarAlertaLeida(idAlerta) {
            try {
                await fetch('/alertas/marcar-leida/' + idAlerta, { method: 'PUT' });
                actualizarContadorAlertas();
                cargarAlertasDropdown();
            } catch (error) {
                console.error('Error marcando alerta:', error);
            }
        }

        document.getElementById('marcarTodasLeidas').addEventListener('click', async function () {
            try {
                await fetch('/alertas/marcar-todas-leidas', { method: 'PUT' });
                actualizarContadorAlertas();
                cargarAlertasDropdown();
            } catch (error) {
                console.error('Error marcando todas:', error);
            }
        });

        actualizarContadorAlertas();
        setInterval(actualizarContadorAlertas, 300000);
    </script>
    <script>DM5.icons();</script>
</body>
<% } else { %>
<body>
    <%- body %>
    <script>DM5.icons();</script>
</body>
<% } %>

</html>
