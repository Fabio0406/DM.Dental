        <div class="page-eyebrow"><i data-lucide="clipboard-list" class="icon-sm"></i> <a href="/solicitudes">Solicitudes de pedido</a></div>
        <h1 class="page-title">Nueva solicitud</h1>
        <p class="page-subtitle">Arma la lista de insumos odontológicos que necesitas pedir.</p>
    </div>
</div>

${locals.error ? `<div class="alert alert-danger alert-dismissible fade show mb-3" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>` : ''}

