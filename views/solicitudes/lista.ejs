<%
const formatearFecha = (fecha) => fecha ? new Date(fecha).toLocaleDateString('es-BO', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '—';
const formatearMoneda = (valor) => 'Bs ' + (parseFloat(valor) || 0).toLocaleString('es-BO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const totalPedido = solicitudes.reduce((s, sol) => s + (parseFloat(sol.total_general) || 0), 0);

const body = `
<div class="page-header">
    <div>
        <div class="page-eyebrow"><i data-lucide="clipboard-list" class="icon-sm"></i> Inventario</div>
        <h1 class="page-title">Solicitudes de pedido</h1>
        <p class="page-subtitle">Pedidos de insumos odontológicos que has generado.</p>
    </div>
    <div class="page-actions">
        <a href="/solicitudes/nueva" class="btn btn-primary"><i data-lucide="plus"></i> Nueva solicitud</a>
    </div>
</div>

${locals.success || locals.error ? `
<div class="flash-stack">
    ${locals.success ? `<div class="alert alert-success alert-dismissible fade show" role="status"><i data-lucide="circle-check"></i><div>${success}</div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>` : ''}
    ${locals.error ? `<div class="alert alert-danger alert-dismissible fade show" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>` : ''}
</div>` : ''}

<div class="card table-card">
    <div class="card-header">
        <h2 class="card-title"><i data-lucide="list"></i> Mis solicitudes</h2>
        ${solicitudes.length ? `<span class="text-muted small">${solicitudes.length} solicitud(es) · Total ${formatearMoneda(totalPedido)}</span>` : ''}
    </div>
    ${solicitudes.length === 0 ? `
        <div class="empty-state">
            <div class="empty-icon"><i data-lucide="clipboard-list"></i></div>
            <h3>No tienes solicitudes registradas</h3>
            <p>Crea una solicitud de pedido para reabastecer los insumos que necesitas.</p>
            <a href="/solicitudes/nueva" class="btn btn-primary"><i data-lucide="plus"></i> Nueva solicitud</a>
        </div>
    ` : `
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>N° solicitud</th>
                        <th>Fecha</th>
                        <th>Material</th>
                        <th class="text-end">Ítems</th>
                        <th class="text-end">Total</th>
                        <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    ${solicitudes.map(sol => `
                        <tr>
                            <td><a href="/solicitudes/ver/${sol.id_solicitud}" class="cell-main text-decoration-none">${esc(sol.nro_solicitud)}</a></td>
                            <td class="num">${formatearFecha(sol.fecha)}</td>
                            <td><span class="badge badge-soft-brand">${esc(sol.material)}</span></td>
                            <td class="text-end num">${sol.total_items}</td>
                            <td class="text-end num fw-semibold">${formatearMoneda(sol.total_general)}</td>
                            <td class="text-end">
                                <div class="action-group">
                                    <a href="/solicitudes/ver/${sol.id_solicitud}" class="btn-icon" title="Ver" aria-label="Ver ${esc(sol.nro_solicitud)}"><i data-lucide="eye" class="icon-sm"></i></a>
                                    <a href="/solicitudes/editar/${sol.id_solicitud}" class="btn-icon" title="Editar" aria-label="Editar ${esc(sol.nro_solicitud)}"><i data-lucide="pencil" class="icon-sm"></i></a>
                                    <a href="/solicitudes/exportar/${sol.id_solicitud}" class="btn-icon" title="Exportar PDF" aria-label="Exportar ${esc(sol.nro_solicitud)} a PDF" target="_blank" rel="noopener"><i data-lucide="file-down" class="icon-sm"></i></a>
                                    <button type="button" class="btn-icon danger" title="Eliminar" aria-label="Eliminar ${esc(sol.nro_solicitud)}"
                                            data-eliminar="${sol.id_solicitud}" data-nro="${esc(sol.nro_solicitud)}">
                                        <i data-lucide="trash-2" class="icon-sm"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `).join('')}
                </tbody>
            </table>
        </div>
    `}
</div>

<!-- Modal de confirmación para eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="eliminarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="eliminarTitulo"><span class="modal-icon danger"><i data-lucide="trash-2"></i></span> Eliminar solicitud</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">¿Seguro que deseas eliminar la solicitud <strong id="nroSolicitudEliminar"></strong>?</p>
                <p class="text-muted small mb-0">Se eliminarán también todos sus ítems. Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminar" method="POST">
                    <button type="submit" class="btn btn-danger"><i data-lucide="trash-2"></i> Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const modalEl = document.getElementById('modalEliminar');
    const modal = new bootstrap.Modal(modalEl);
    document.querySelectorAll('[data-eliminar]').forEach(btn => {
        btn.addEventListener('click', function () {
            document.getElementById('nroSolicitudEliminar').textContent = this.dataset.nro;
            document.getElementById('formEliminar').action = '/solicitudes/eliminar/' + this.dataset.eliminar;
            modal.show();
        });
    });
})();
</script>
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
