<%
const itemsExistentes = (solicitud.detalles || []).map(det => {
    const cantidad = parseInt(det.cantidad) || 0;
    const total = parseFloat(det.costo_total) || 0;
    return {
        id_insumo: det.id_insumo,
        codigo: det.codigo,
        nombre: det.nombre_generico,
        presentacion: det.presentacion || 'Unidad',
        cantidad,
        precio_unitario: cantidad ? total / cantidad : parseFloat(det.costo_unitario) || 0,
        precio_total: total
    };
});

const formHtml = include('_form', {
    action: '/solicitudes/editar/' + solicitud.id_solicitud,
    insumos,
    items: itemsExistentes,
    submitLabel: 'Guardar cambios'
});

const body = `
<div class="page-header">
    <div>
        <div class="page-eyebrow"><i data-lucide="clipboard-list" class="icon-sm"></i> <a href="/solicitudes">Solicitudes de pedido</a> <i data-lucide="chevron-right" class="icon-sm"></i> ${esc(solicitud.nro_solicitud)}</div>
        <h1 class="page-title">Editar solicitud</h1>
        <p class="page-subtitle">Modifica los insumos o cantidades de la solicitud ${esc(solicitud.nro_solicitud)}.</p>
    </div>
    <div class="page-actions">
        <a href="/solicitudes/ver/${solicitud.id_solicitud}" class="btn btn-light"><i data-lucide="eye"></i> Ver solicitud</a>
    </div>
</div>

${locals.error ? `<div class="alert alert-danger alert-dismissible fade show mb-3" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>` : ''}

${formHtml}
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
