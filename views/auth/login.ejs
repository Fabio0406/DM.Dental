<%
const body = `
<div class="auth-shell">
    <aside class="auth-aside">
        <div class="auth-brand">
            <img src="/images/escudo.png" alt="">
            <div>
                <strong>Sistema DM-5</strong>
                <span>Gestión de inventario odontológico</span>
            </div>
        </div>

        <div>
            <h2>Control de insumos claro, trazable y a tiempo.</h2>
            <p class="lead">Registra consumos por protocolo, lleva el kardex valorado y anticípate a vencimientos y desabastecimientos.</p>
            <ul class="auth-features">
                <li>
                    <span class="feat-icon"><i data-lucide="book-open"></i></span>
                    <div><strong>Kardex valorado</strong><span>Entradas, salidas y saldos con método FIFO.</span></div>
                </li>
                <li>
                    <span class="feat-icon"><i data-lucide="bell-ring"></i></span>
                    <div><strong>Alertas automáticas</strong><span>Stock crítico y lotes próximos a vencer.</span></div>
                </li>
                <li>
                    <span class="feat-icon"><i data-lucide="scan-line"></i></span>
                    <div><strong>Ingreso por formulario SALMI</strong><span>Digitaliza el formulario y confirma el ingreso.</span></div>
                </li>
            </ul>
        </div>

        <div class="auth-foot">© ${new Date().getFullYear()} Sistema DM-5</div>
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <div class="auth-mobile-brand">
                <img src="/images/escudo.png" alt=""> Sistema DM-5
            </div>

            <h1>Iniciar sesión</h1>
            <p class="auth-sub">Ingresa con tu usuario para continuar.</p>

            ${locals.success ? `<div class="alert alert-success mb-4"><i data-lucide="circle-check"></i><div>${success}</div></div>` : ''}
            ${error ? `<div class="alert alert-danger mb-4" role="alert"><i data-lucide="circle-alert"></i><div>${error}</div></div>` : ''}

            <form method="POST" action="/auth/login" data-loading="Ingresando…">
                <div class="mb-3">
                    <label for="username" class="form-label">Usuario</label>
                    <div class="input-icon">
                        <i data-lucide="user"></i>
                        <input type="text" class="form-control form-control-lg" id="username" name="username"
                               autocomplete="username" autofocus required placeholder="ej. dr.martinez">
                    </div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Contraseña</label>
                    <div class="password-field input-icon">
                        <i data-lucide="lock"></i>
                        <input type="password" class="form-control form-control-lg" id="password" name="password"
                               autocomplete="current-password" required placeholder="••••••••">
                        <button type="button" class="password-toggle" data-toggle-password="password" aria-label="Mostrar contraseña">
                            <i data-lucide="eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i data-lucide="log-in"></i> Ingresar
                </button>
            </form>

            <p class="text-center text-muted small mt-4 mb-0">
                ¿No tienes una cuenta? <a href="/auth/register" class="fw-semibold">Regístrate</a>
            </p>
        </div>
    </main>
</div>
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
