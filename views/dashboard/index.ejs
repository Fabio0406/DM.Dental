<%
// JSON seguro para incrustar dentro de <script>
const safeJson = (json) => String(json || '[]').replace(/</g, '\\u003c');

const hora = new Date().getHours();
const saludo = hora < 12 ? 'Buenos días' : hora < 19 ? 'Buenas tardes' : 'Buenas noches';
const fechaHoy = new Date().toLocaleDateString('es-BO', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

const tasa = tasaDesabastecimiento;
const tasaPct = tasa ? (parseFloat(tasa.porcentaje_desabastecimiento) || 0) : 0;
const tasaTono = tasaPct > 30 ? 'danger' : tasaPct > 15 ? 'warning' : 'success';
const tasaTexto = tasaPct > 30 ? 'Crítico' : tasaPct > 15 ? 'Requiere atención' : 'Normal';

const body = `
<div class="page-header">
    <div>
        <div class="page-eyebrow"><i data-lucide="calendar-days" class="icon-sm"></i> ${fechaHoy}</div>
        <h1 class="page-title">${saludo}, ${esc(user.nombres)}</h1>
        <p class="page-subtitle">Este es el estado actual de tu inventario odontológico.</p>
    </div>
    <div class="page-actions">
        <a href="/ocr/upload" class="btn btn-light"><i data-lucide="scan-line"></i> Ingresar insumos</a>
        <a href="/consumos/registro" class="btn btn-primary"><i data-lucide="package-minus"></i> Registrar consumo</a>
    </div>
</div>

${stats ? `
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card tone-info">
            <span class="stat-icon"><i data-lucide="package"></i></span>
            <div>
                <p class="stat-label">Insumos registrados</p>
                <p class="stat-value">${stats.total_insumos}</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card tone-success">
            <span class="stat-icon"><i data-lucide="package-check"></i></span>
            <div>
                <p class="stat-label">Con stock vigente</p>
                <p class="stat-value">${stats.en_stock}</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <a href="#" class="text-decoration-none" data-bs-toggle="modal" data-bs-target="#modalAlertasInicio">
            <div class="stat-card ${resumenAlertas.total > 0 ? 'tone-warning' : 'tone-neutral'}">
                <span class="stat-icon"><i data-lucide="bell-ring"></i></span>
                <div>
                    <p class="stat-label">Alertas pendientes</p>
                    <p class="stat-value">${resumenAlertas.total}</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card tone-neutral">
            <span class="stat-icon"><i data-lucide="activity"></i></span>
            <div>
                <p class="stat-label">Consumo del mes</p>
                <p class="stat-value">${stats.consumo_mes}</p>
                <p class="stat-hint">aplicaciones</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title"><i data-lucide="gauge"></i> Desabastecimiento</h2>
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                ${tasa ? `
                    <div class="kpi-figure kpi-${tasaTono}">${tasaPct.toFixed(0)}<span class="fs-4">%</span></div>
                    <p class="text-muted small mt-2 mb-3">${tasa.insumos_bajo_stock} de ${tasa.total_insumos} insumos en o bajo el stock mínimo</p>
                    <div class="meter ${tasaTono} mb-3" role="progressbar" aria-valuenow="${tasaPct}" aria-valuemin="0" aria-valuemax="100" aria-label="Tasa de desabastecimiento">
                        <span style="width: ${Math.min(tasaPct, 100)}%"></span>
                    </div>
                    <span class="badge badge-soft-${tasaTono} align-self-start"><span class="status-dot"></span> ${tasaTexto}</span>
                ` : '<p class="text-muted mb-0">Sin datos disponibles</p>'}
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-5">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title"><i data-lucide="chart-column"></i> Stock por categoría</h2>
                    <p class="card-subtitle">Aplicaciones disponibles en lotes activos</p>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-box"><canvas id="graficoStockCategoria" aria-label="Gráfico de stock por categoría" role="img"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header">
                <div>
                    <h2 class="card-title"><i data-lucide="chart-pie"></i> Lotes por vencer</h2>
                    <p class="card-subtitle">Próximos 90 días, por rango</p>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-box" id="vencimientosChartBox"><canvas id="graficoVencimientos" aria-label="Gráfico de lotes por vencer" role="img"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="card table-card">
    <div class="card-header">
        <div>
            <h2 class="card-title"><i data-lucide="clock"></i> Próximos vencimientos</h2>
            <p class="card-subtitle">Los 10 lotes con stock que vencen primero</p>
        </div>
        <div class="chip-legend">
            <span class="badge badge-soft-danger">≤ 30 días</span>
            <span class="badge badge-soft-warning">≤ 60 días</span>
            <span class="badge badge-soft-info">≤ 90 días</span>
        </div>
    </div>
    ${detalleVencer && detalleVencer.length > 0 ? `
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Insumo</th>
                    <th>Lote</th>
                    <th>Vence</th>
                    <th>Restan</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Valor</th>
                </tr>
            </thead>
            <tbody>
                ${detalleVencer.map(item => {
                    const dias = parseInt(item.dias_restantes);
                    const tono = dias <= 30 ? 'danger' : dias <= 60 ? 'warning' : 'info';
                    return `
                    <tr>
                        <td>
                            <span class="cell-main">${esc(item.nombre_generico)}</span>
                            <span class="cell-sub"><code>${esc(item.codigo)}</code></span>
                        </td>
                        <td>${esc(item.numero_lote)}</td>
                        <td class="num">${new Date(item.fecha_vencimiento).toLocaleDateString('es-BO')}</td>
                        <td><span class="badge badge-soft-${tono}">${dias} días</span></td>
                        <td class="text-end num">${item.aplicaciones_disponibles}</td>
                        <td class="text-end num">Bs ${parseFloat(item.valor_lote).toFixed(2)}</td>
                    </tr>`;
                }).join('')}
            </tbody>
        </table>
    </div>
    ` : `
    <div class="empty-state">
        <div class="empty-icon"><i data-lucide="calendar-check"></i></div>
        <h3>Sin vencimientos próximos</h3>
        <p>Ningún lote con stock vence en los próximos 90 días.</p>
    </div>
    `}
</div>
` : `
<div class="alert alert-warning"><i data-lucide="triangle-alert"></i><div>No se pudieron cargar las estadísticas. Intenta recargar la página.</div></div>
`}

<!-- Modal de alertas -->
<div class="modal fade" id="modalAlertasInicio" tabindex="-1" aria-labelledby="modalAlertasTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="modalAlertasTitulo">
                    <span class="modal-icon warning"><i data-lucide="bell-ring"></i></span>
                    Alertas del inventario
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <div class="stat-card tone-danger">
                            <span class="stat-icon"><i data-lucide="package-x"></i></span>
                            <div>
                                <p class="stat-label">Desabastecimiento</p>
                                <p class="stat-value" id="contadorDesabastecimiento">${resumenAlertas.desabastecimiento}</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="stat-card tone-warning">
                            <span class="stat-icon"><i data-lucide="clock"></i></span>
                            <div>
                                <p class="stat-label">Vencimiento</p>
                                <p class="stat-value" id="contadorVencimiento">${resumenAlertas.vencimiento}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabTodas" type="button" role="tab">
                            Todas <span class="badge badge-soft-neutral" id="badgeTodas">${resumenAlertas.total}</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDesabastecimiento" type="button" role="tab">
                            <i data-lucide="package-x" class="icon-sm"></i> Desabastecimiento
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabVencimiento" type="button" role="tab">
                            <i data-lucide="clock" class="icon-sm"></i> Vencimiento
                        </button>
                    </li>
                </ul>

                <div class="tab-content pt-3">
                    <div class="tab-pane fade show active" id="tabTodas" role="tabpanel"><div id="listaAlertasTodas"></div></div>
                    <div class="tab-pane fade" id="tabDesabastecimiento" role="tabpanel"><div id="listaAlertasDesabastecimiento"></div></div>
                    <div class="tab-pane fade" id="tabVencimiento" role="tabpanel"><div id="listaAlertasVencimiento"></div></div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-light" id="btnMarcarTodasLeidasModal">
                    <i data-lucide="check-check"></i> Marcar todas como leídas
                </button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<script src="/node_modules/chart.js/dist/chart.umd.js"></script>
<script>
const stockPorCategoria = ${safeJson(stockPorCategoria)};
const insumosVencer = ${safeJson(insumosVencer)};
let alertasActivas = ${safeJson(alertasActivas)};

// ---------- Gráficos ----------
const charts = [];
function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }

function emptyChart(canvasId, texto) {
    const box = document.getElementById(canvasId).parentElement;
    box.innerHTML = '<div class="empty-state py-4"><div class="empty-icon"><i data-lucide="chart-no-axes-column"></i></div><p class="mb-0">' + texto + '</p></div>';
    box.classList.remove('chart-box');
}

function renderCharts() {
    charts.forEach(c => c.destroy());
    charts.length = 0;
    Chart.defaults.font.family = cssVar('--font');
    Chart.defaults.color = cssVar('--muted');
    const grid = cssVar('--border');

    if (document.getElementById('graficoStockCategoria')) {
        if (stockPorCategoria.length > 0) {
            charts.push(new Chart(document.getElementById('graficoStockCategoria'), {
                type: 'bar',
                data: {
                    labels: stockPorCategoria.map(i => i.categoria),
                    datasets: [{
                        label: 'Aplicaciones',
                        data: stockPorCategoria.map(i => parseInt(i.total_aplicaciones)),
                        backgroundColor: '#17A6A6',
                        hoverBackgroundColor: '#0B688C',
                        borderRadius: 6,
                        maxBarThickness: 36
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: grid }, border: { display: false } },
                        x: { grid: { display: false }, ticks: { autoSkip: false, maxRotation: 40, callback: function (v) { const l = this.getLabelForValue(v); return l.length > 14 ? l.slice(0, 13) + '…' : l; } } }
                    }
                }
            }));
        } else {
            emptyChart('graficoStockCategoria', 'Aún no hay stock registrado');
        }
    }

    if (document.getElementById('graficoVencimientos')) {
        if (insumosVencer.length > 0) {
            const colores = { '30': '#DC2626', '60': '#F59E0B', '90': '#0B688C' };
            charts.push(new Chart(document.getElementById('graficoVencimientos'), {
                type: 'doughnut',
                data: {
                    labels: insumosVencer.map(i => 'Hasta ' + i.rango_dias + ' días'),
                    datasets: [{
                        data: insumosVencer.map(i => parseInt(i.cantidad_lotes)),
                        backgroundColor: insumosVencer.map(i => colores[i.rango_dias] || '#64748B'),
                        borderWidth: 3,
                        borderColor: cssVar('--surface')
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 14 } },
                        tooltip: { callbacks: { label: c => ' ' + c.parsed + ' lote(s)' } }
                    }
                }
            }));
        } else {
            emptyChart('graficoVencimientos', 'Sin lotes por vencer en 90 días');
        }
    }
    DM5.icons();
}

renderCharts();
document.addEventListener('dm5:themechange', renderCharts);

// ---------- Alertas ----------
function tipoAlerta(a) {
    if (a.titulo.includes('Desabastecimiento')) return { tono: 'danger', icono: 'package-x' };
    if (a.titulo.includes('VENCIDO')) return { tono: 'danger', icono: 'circle-x' };
    if (a.titulo.includes('Vencimiento')) return { tono: 'warning', icono: 'clock' };
    return { tono: 'info', icono: 'info' };
}

function renderAlertaItem(alerta) {
    const t = tipoAlerta(alerta);
    return '<div class="alert-row ' + t.tono + '">' +
        '<span class="notif-icon ' + t.tono + '"><i data-lucide="' + t.icono + '" class="icon-sm"></i></span>' +
        '<div class="flex-grow-1">' +
            '<p class="alert-row-title">' + DM5.escape(alerta.titulo) + '</p>' +
            '<p class="alert-row-text">' + DM5.escape(alerta.mensaje) + '</p>' +
            '<small class="text-muted">' + DM5.fecha(alerta.fecha_creacion, true) + '</small>' +
        '</div>' +
        '<button class="btn-icon" onclick="marcarAlertaLeidaModal(' + alerta.id_alerta + ')" title="Marcar como leída" aria-label="Marcar como leída">' +
            '<i data-lucide="check" class="icon-sm"></i>' +
        '</button>' +
    '</div>';
}

function vacio(texto) {
    return '<div class="empty-state py-4"><div class="empty-icon"><i data-lucide="circle-check"></i></div><p class="mb-0">' + texto + '</p></div>';
}

function renderizarAlertas() {
    const desab = alertasActivas.filter(a => a.titulo.includes('Desabastecimiento'));
    const venc = alertasActivas.filter(a => a.titulo.includes('Vencimiento') || a.titulo.includes('VENCIDO'));

    document.getElementById('listaAlertasTodas').innerHTML = alertasActivas.length ? alertasActivas.map(renderAlertaItem).join('') : vacio('No hay alertas pendientes');
    document.getElementById('listaAlertasDesabastecimiento').innerHTML = desab.length ? desab.map(renderAlertaItem).join('') : vacio('Sin alertas de desabastecimiento');
    document.getElementById('listaAlertasVencimiento').innerHTML = venc.length ? venc.map(renderAlertaItem).join('') : vacio('Sin alertas de vencimiento');

    document.getElementById('contadorDesabastecimiento').textContent = desab.length;
    document.getElementById('contadorVencimiento').textContent = venc.length;
    document.getElementById('badgeTodas').textContent = alertasActivas.length;
    DM5.icons();
}

async function marcarAlertaLeidaModal(idAlerta) {
    try {
        await fetch('/alertas/marcar-leida/' + idAlerta, { method: 'PUT' });
        alertasActivas = alertasActivas.filter(a => a.id_alerta !== idAlerta);
        renderizarAlertas();
        if (typeof actualizarContadorAlertas === 'function') actualizarContadorAlertas();
    } catch (error) {
        DM5.toast('No se pudo marcar la alerta', 'danger');
    }
}

document.getElementById('btnMarcarTodasLeidasModal').addEventListener('click', async function () {
    try {
        await fetch('/alertas/marcar-todas-leidas', { method: 'PUT' });
        alertasActivas = [];
        renderizarAlertas();
        if (typeof actualizarContadorAlertas === 'function') actualizarContadorAlertas();
        DM5.toast('Todas las alertas se marcaron como leídas');
    } catch (error) {
        DM5.toast('No se pudieron marcar las alertas', 'danger');
    }
});

renderizarAlertas();

// Abrir el resumen de alertas solo una vez por sesión del navegador
if (${mostrarModalAlertas ? 'true' : 'false'} && alertasActivas.length > 0) {
    let visto = false;
    try { visto = sessionStorage.getItem('dm5-alertas-vistas') === '1'; sessionStorage.setItem('dm5-alertas-vistas', '1'); } catch (e) {}
    if (!visto) new bootstrap.Modal(document.getElementById('modalAlertasInicio')).show();
}
</script>
`;
%>

<%- include('../layouts/main', { title: title, body: body }) %>
